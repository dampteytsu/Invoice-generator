# Real secrets and machine-specific overrides go in .env.local (not committed).

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me_to_a_random_32_char_string
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
# SQLite works out of the box. For MySQL/MariaDB use e.g.:
# DATABASE_URL="mysql://user:pass@127.0.0.1:3306/ghana_invoice?serverVersion=8.0.32&charset=utf8mb4"
DATABASE_URL="sqlite:///%kernel.project_dir%/var/data.db"
###< doctrine/doctrine-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:pass@smtp.yourprovider.com:587
MAILER_FROM="Invoicer <security@yourdomain.com>"
###< symfony/mailer ###
